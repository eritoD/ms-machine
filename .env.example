MATCHING_DATABASE_URL=postgresql://sportmach_matching:CHANGE_ME@127.0.0.1:5432/sportmach_matching
USERS_SERVICE_URL=http://127.0.0.1:8001
JWT_SECRET=replace-with-the-same-secret-as-users-at-least-32-bytes
JWT_ISSUER=sportmatch-auth
JWT_AUDIENCE=sportmatch-mobile
# Hosts whose https links the chat accepts as image / file attachments, comma separated
# ("*.example.com" also allows subdomains). Empty: image and file messages are refused.
CHAT_ATTACHMENT_HOSTS=
# HU-54: plan limits come from ms-pago (internal network). Empty: limits are not enforced (fail-open).
PAYMENTS_SERVICE_URL=http://127.0.0.1:8005
PAYMENTS_TIMEOUT_SECONDS=2
ENTITLEMENTS_CACHE_SECONDS=60
# Same shared secret as ms-pago and Ms_Users (at least 32 bytes).
INTERNAL_SERVICE_TOKEN=
